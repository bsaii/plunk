# Copy to deploy/config.env (gitignored) and fill in.
#
#   cp deploy/config.example.env deploy/config.env
#
# Read by scripts/deploy.sh, scripts/gcp-bootstrap.sh and
# scripts/setup-cloud-build-trigger.sh. Nothing secret belongs here — this file
# names resources and points at Secret Manager, it does not hold values.

# --- Project and registry ----------------------------------------------------
PROJECT_ID=
# Must be a region that offers Cloud Run worker pools; gcp-bootstrap.sh checks.
REGION=europe-west1
AR_REPO=plunk

# --- Workload names ----------------------------------------------------------
API_SERVICE=plunk-api
WEB_SERVICE=plunk-web
# A Cloud Run *worker pool*, not a service — see docs/deploy-cloud-run.md.
WORKER_POOL=plunk-worker
# Instance count for the pool (manual scaling). 0 pauses queue processing.
WORKER_INSTANCES=1

# --- Migrations --------------------------------------------------------------
# The existing Cloud Run Job that runs `prisma migrate deploy`. Each deploy
# repoints it at the new api image and executes it before anything is rolled
# out. Leave empty to take migrations out of the pipeline entirely.
MIGRATE_JOB=plunk-migrate

# --- Identity ----------------------------------------------------------------
# Runtime identity for the deployed workloads (needs secretmanager.secretAccessor
# and whatever your database access requires). Created by gcp-bootstrap.sh.
RUNTIME_SA=plunk-run@PROJECT_ID.iam.gserviceaccount.com
# Identity the build itself runs as. Leave empty to use the project default.
BUILD_SA=plunk-build@PROJECT_ID.iam.gserviceaccount.com

# --- Secrets -----------------------------------------------------------------
# Mapped as ENV_NAME=secret-name:version, comma separated. These are references,
# not values: Cloud Run resolves them from Secret Manager at instance start.
# Every variable in apps/api/src/app/constants.ts that throws when missing must
# appear here or in deploy/env/*.yaml.
API_SECRETS=JWT_SECRET=plunk-jwt-secret:latest,DATABASE_URL=plunk-database-url:latest,DIRECT_DATABASE_URL=plunk-direct-database-url:latest,REDIS_URL=plunk-redis-url:latest,AWS_SES_ACCESS_KEY_ID=plunk-ses-access-key-id:latest,AWS_SES_SECRET_ACCESS_KEY=plunk-ses-secret-access-key:latest
WORKER_SECRETS=JWT_SECRET=plunk-jwt-secret:latest,DATABASE_URL=plunk-database-url:latest,DIRECT_DATABASE_URL=plunk-direct-database-url:latest,REDIS_URL=plunk-redis-url:latest,AWS_SES_ACCESS_KEY_ID=plunk-ses-access-key-id:latest,AWS_SES_SECRET_ACCESS_KEY=plunk-ses-secret-access-key:latest

# --- Networking (optional) ---------------------------------------------------
# Set when Postgres/Redis are only reachable privately.
VPC_CONNECTOR=
CLOUDSQL_INSTANCES=

# --- GitHub trigger (optional) -----------------------------------------------
# Used by scripts/setup-cloud-build-trigger.sh.
GITHUB_OWNER=bsaii
GITHUB_REPO=plunk
TRIGGER_BRANCH=^production$
TRIGGER_NAME=plunk-deploy
