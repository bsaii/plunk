# Controls what `gcloud builds submit` uploads as the Cloud Build source.
# Without this, gcloud falls back to .gitignore's rules, which is close but
# not quite right for a build submission (e.g. it doesn't need to exclude
# .git, since gcloud already does that by default) — being explicit here
# keeps the upload small and fast regardless of what .gitignore says later.

.git
.gcloudignore

# Dependencies (reinstalled fresh inside the Cloud Build container)
node_modules
**/node_modules
.pnp
.pnp.js
.yarn/cache
.yarn/install-state.gz

# Build outputs (regenerated by the Dockerfile build stages)
**/dist
**/.next
**/.turbo
**/build
**/out

# Local env files — never upload secrets as build source
.env
.env*.local

# Editor/OS cruft
.vscode
.idea
.DS_Store
*.log
